{
  "name": "2024 CUMCM 参赛论文检索评测集",
  "note": "expect 中的关键词需同时命中同一个块才算检索正确；用于比较 BM25 与 RRF 混合检索。",
  "questions": [
    {
      "q": "这个乡村一共有多少个地块？",
      "expect": [
        "34 个地块"
      ]
    },
    {
      "q": "普通大棚和智慧大棚分别有多少个？",
      "expect": [
        "16 个普通大棚",
        "4 个智慧大棚"
      ]
    },
    {
      "q": "规划期是从哪一年到哪一年？",
      "expect": [
        "2024",
        "2030"
      ]
    },
    {
      "q": "露天耕地总共有多少亩？",
      "expect": [
        "1201"
      ]
    },
    {
      "q": "每个大棚的耕地面积是多少？",
      "expect": [
        "0.6 亩"
      ]
    },
    {
      "q": "智慧大棚适合什么种植模式？",
      "expect": [
        "两季蔬菜"
      ]
    },
    {
      "q": "问题二使用什么算法处理不确定性？",
      "expect": [
        "模拟退火"
      ]
    },
    {
      "q": "模拟退火设置了多少次搜索？",
      "expect": [
        "1000000"
      ]
    },
    {
      "q": "豆类作物要求几年内至少种植一次？",
      "expect": [
        "三年"
      ]
    },
    {
      "q": "超过预期销售量的部分有哪两种处理方式？",
      "expect": [
        "不得出售",
        "一半"
      ]
    },
    {
      "q": "小麦和玉米预期销售量的年增长率范围是多少？",
      "expect": [
        "5%—10%"
      ]
    },
    {
      "q": "农作物亩产量每年波动多少？",
      "expect": [
        "10%"
      ]
    },
    {
      "q": "问题一采用了哪两种算法思想？",
      "expect": [
        "状态压缩",
        "贪心"
      ]
    },
    {
      "q": "模型的目标函数是什么？",
      "expect": [
        "利润最大化"
      ]
    },
    {
      "q": "求解时如何划分子问题？",
      "expect": [
        "粮食",
        "非粮食"
      ]
    }
  ]
}
